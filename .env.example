# Prayas Foundation SMTP & Live Email Configuration
# To send actual 80G tax exemption receipts to real donor inboxes via Gmail or custom domain SMTP,
# copy this file to .env and enter your credentials:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail, create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME="Prayas Foundation Trust"
